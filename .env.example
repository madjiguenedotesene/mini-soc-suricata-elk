# Copier en .env puis remplacer TOUTES les valeurs « changeme » (ne jamais committer .env)

STACK_VERSION=8.19.9
CLUSTER_NAME=mini-soc

# Mots de passe (au moins 12 caractères)
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
GRAFANA_ADMIN_PASSWORD=changeme

# Clé de chiffrement Kibana (32 caractères minimum) : openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=changeme

# Interface réseau écoutée par Suricata (ex. eth0, ens33) et réseau surveillé
SURICATA_IFACE=eth0
HOME_NET=[10.10.0.0/24]

# Ports exposés sur la machine hôte (127.0.0.1 = accès local uniquement)
ES_PORT=127.0.0.1:9200
KIBANA_PORT=127.0.0.1:5601
GRAFANA_PORT=127.0.0.1:3000

MEM_LIMIT=2147483648
